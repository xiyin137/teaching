# Multi-beta scan profile for latticeYM3d on Harvard RC.
# Copy to env.harvard.scan and source before submit.

# Partition choice:
export PARTITION=shared
# export PARTITION=yin

# Per-beta statistics:
export TOTAL_CHAINS=64
export TOTAL_MEAS=20000
export SEED_BASE=12345

# Beta points (space- or comma-separated):
export BETA_LIST='5.5 6.0 7.0'

# Job naming and output layout:
export JOB_PREFIX=ym3d_scan
# Optional: fixed scan tag for reproducible output path.
# export SCAN_TAG=scan_20260302
# Optional: absolute scan root override.
# export SCAN_ROOT='/n/home11/xiyin/projects/MonteCarlo/cluster/results/beta_scan/my_scan'

# Physics params (optional overrides)
export LATTICE_L=32
export N_THERM=1000
export N_SKIP=50
export EPSILON_MET=0.3

# Runtime environment:
export VENV_ACTIVATE='/n/home11/xiyin/projects/MonteCarlo/.venv/bin/activate'
# export PYTHON_BIN=python3

# Optional extra sbatch args:
# export SBATCH_EXTRA_ARGS='--cpus-per-task=1 --mem=8G --time=08:00:00'
