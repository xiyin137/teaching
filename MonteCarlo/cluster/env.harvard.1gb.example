# 1GB-target profile for latticeYM3d merged output at L=32.
# Approx merged size scales as 1056 * TOTAL_MEAS bytes.
# TOTAL_MEAS=900000 -> ~0.88 GiB merged (before optional compression gains).

# Partition choice:
# export PARTITION=yin
export PARTITION=shared

# Parallelism/statistics:
export TOTAL_CHAINS=256
export TOTAL_MEAS=900000
export SEED_BASE=12345
export JOB_PREFIX=ym3d_1gb

# Keep physics params at current baseline:
export LATTICE_L=32
export BETA=6.0
export N_THERM=1000
export N_SKIP=50
export EPSILON_MET=0.3

# Optional cluster env:
# export HARVARD_MODULE_LOAD='module load gcc/13.2.0'
# export VENV_ACTIVATE='/n/home00/your_user/projects/MonteCarlo/.venv/bin/activate'
# export PYTHON_BIN=python3

# Optional output root:
# export OUTPUT_ROOT='/n/holylabs/LABS/<lab>/users/<you>/ym3d_shards'

# Optional sbatch tuning:
# export SBATCH_EXTRA_ARGS='--cpus-per-task=1 --mem=8G --time=12:00:00'
