# Copy to env.harvard and source before submission:
#   source ./env.harvard

# Partition choice: shared or yin
export PARTITION=shared

# Array/chunk configuration
export TOTAL_CHAINS=64
export TOTAL_MEAS=3000
export SEED_BASE=12345
export JOB_PREFIX=ym3d

# Optional simulation-parameter overrides
# export LATTICE_L=32
# export BETA=6.0
# export N_THERM=1000
# export N_SKIP=50
# export EPSILON_MET=0.3

# Optional runtime environment
# export HARVARD_MODULE_LOAD='module load gcc/13.2.0'
# export VENV_ACTIVATE='/path/to/venv/bin/activate'
# export PYTHON_BIN=python3

# Optional output location
# export OUTPUT_ROOT='/n/holylabs/LABS/<lab>/users/<you>/ym3d_shards'

# Optional extra sbatch args
# export SBATCH_EXTRA_ARGS='--cpus-per-task=1 --mem=8G --time=08:00:00'
