# Harvard RC example configuration for mixed-correlator island scans.
#
# Typical flow:
#   source env.harvard.example
#   sbatch run_island_harvard.slurm
# or fan-out by sigma slices:
#   bash submit_island_harvard.sh --time=12:00:00 --partition=shared

export PYTHON_BIN=python3

# Optional virtualenv and module hook.
# export VENV_ACTIVATE=/n/homeXX/you/venvs/cft/bin/activate
# export HARVARD_MODULE_LOAD='module load gcc/12.2.0-fasrc01 openmpi/4.1.5-fasrc01'

# Optional executable overrides if SDPB/mpirun are not on PATH.
# export SDPB_PATH=/n/homeXX/you/sdpb/bin/sdpb
# export MPIRUN_PATH=/usr/bin/mpirun
# export MPIRUN_NP=8

# Mixed-island grid.
export SIGMA_START=0.517
export SIGMA_END=0.521
export SIGMA_STEP=0.001
export EPSILON_START=1.410
export EPSILON_END=1.435
export EPSILON_STEP=0.0025

# Truncation and numerical controls.
export DIM=3
export K_MAX=25
export L_MAX=20
export M_MAX=2
export N_MAX=6
export CUTOFF=0.15
# Z2-even scalar assumption:
#   tutorial          -> gap starts at Delta_epsilon (PyCFTBoot tutorial)
#   isolated_epsilon  -> pin epsilon at Delta_epsilon, gap others at dim
export EVEN_SCALAR_ASSUMPTION=tutorial
# Use strict dual error for production-quality mixed feasibility checks.
export DUAL_ERROR_THRESHOLD=1e-30
export MAX_POINTS=1200

# Paths.
export PYCFTBOOT_DIR="$(pwd)/../ising3d/vendor/pycftboot"
export SDPB_OPTIONS="$(pwd)/../ising3d/sdpb_options.json"
export OUTPUT_ROOT=/n/homeXX/you/ising3d_mixed_runs
export NAME_PREFIX=ising3d_mixed

# Optional for fan-out submission script.
export JOB_PREFIX=ising3d_mixed

# Example larger run profile (uncomment and adjust):
# export SIGMA_START=0.516
# export SIGMA_END=0.520
# export SIGMA_STEP=0.0005
# export EPSILON_START=1.390
# export EPSILON_END=1.470
# export EPSILON_STEP=0.002
