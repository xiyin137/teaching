# Local example configuration for mixed-correlator island scans.
#
# 1) Source SDPB wrappers from the scalar-bootstrap folder:
#    source ../ising3d/setup_sdpb_local.sh
# 2) Optionally source this file:
#    source env.local.example
# 3) Run:
#    bash run_island_local.sh

export PYTHON_BIN=python3
export PYCFTBOOT_DIR="$(pwd)/../ising3d/vendor/pycftboot"

# Optional explicit executable overrides.
# export SDPB_PATH="$(pwd)/../ising3d/bin/sdpb"
# export MPIRUN_PATH="$(pwd)/../ising3d/bin/mpirun"
# export MPIRUN_NP=1

# Mixed-island grid.
export SIGMA_START=0.517
export SIGMA_END=0.521
export SIGMA_STEP=0.001
export EPSILON_START=1.410
export EPSILON_END=1.435
export EPSILON_STEP=0.0025

# Truncation and numerical controls.
export DIM=3
export K_MAX=25
export L_MAX=20
export M_MAX=2
export N_MAX=6
export CUTOFF=0.15
export DUAL_ERROR_THRESHOLD=1e-15
export MAX_POINTS=1200

# Outputs and naming.
export NAME_PREFIX=ising3d_mixed
export OUTPUT_ROOT="$(pwd)/results/local_mixed_island"
export SDPB_OPTIONS="$(pwd)/../ising3d/sdpb_options.json"
