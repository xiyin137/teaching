# Local laptop example configuration.
# These variables control:
# 1) conformal block truncation parameters,
# 2) bisection search window,
# 3) SDPB execution path (Docker-backed wrappers by default).
export PYTHON_BIN=python3
export ISING3D_ROOT=/path/to/teaching/Bootstrap/ising3d

# One-time per shell: source setup_sdpb_local.sh to enable Docker-backed SDPB wrappers
# source "$ISING3D_ROOT/setup_sdpb_local.sh"

# If you sourced setup_sdpb_local.sh, these are set automatically.
# They determine how PyCFTBoot calls pmp2sdp/sdpb for each sigma point.
export SDPB_PATH="${SDPB_PATH:-$ISING3D_ROOT/bin/sdpb}"
export MPIRUN_PATH="${MPIRUN_PATH:-$ISING3D_ROOT/bin/mpirun}"
export MPIRUN_NP=1

# Optional: choose a different SDPB image tag
export SDPB_DOCKER_IMAGE=bootstrapcollaboration/sdpb:master

# Scan range in Delta_sigma
export SIGMA_START=0.518
export SIGMA_END=0.521
export SIGMA_STEP=0.001

# Numerical setup
export DIM=3
export K_MAX=25
export L_MAX=20
export M_MAX=1
export N_MAX=4
# Local stability default. At higher truncations, 0.25 can trigger NaN
# coefficients in PyCFTBoot XML generation on some environments.
export CUTOFF=0.20
export BISECT_LOWER=1.0
export BISECT_UPPER=2.0
export BISECT_TOL=1e-4

# Output
export OUTPUT_ROOT="${OUTPUT_ROOT:-$ISING3D_ROOT/results/local}"
