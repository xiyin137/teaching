# Harvard RC example configuration.
# These variables control:
# 1) conformal block truncation in the Python driver,
# 2) SDP bisection range for each sigma point,
# 3) how PyCFTBoot locates/calls pmp2sdp + sdpb on the cluster.
export PYTHON_BIN=python3

# Optional virtualenv activation script
# export VENV_ACTIVATE=/n/homeXX/you/venvs/cft/bin/activate

# Optional SDPB/mpirun overrides for PyCFTBoot.
# If unset, PyCFTBoot uses its internal defaults/PATH lookup.
# Set these when RC modules place binaries in nonstandard locations.
# export SDPB_PATH=/n/homeXX/you/sdpb/bin/sdpb
# export MPIRUN_PATH=/usr/bin/mpirun
# export MPIRUN_NP=8

# Scan range in Delta_sigma
export SIGMA_START=0.518
export SIGMA_END=0.521
export SIGMA_STEP=0.001

# Numerical setup
# The Python driver uses these in:
#   ConformalBlockTable(dim, k_max, l_max, m_max, n_max)
# followed by ConvolvedBlockTable(table), then SDP(...).bisect(...)
export DIM=3
export K_MAX=25
export L_MAX=20
export M_MAX=1
export N_MAX=4
# Keep cutoff in the locally validated stable range [0.15, 0.20].
export CUTOFF=0.20
export BISECT_LOWER=1.0
export BISECT_UPPER=2.0
export BISECT_TOL=1e-4

# Output location
# Each sigma point writes a subdirectory sigma_<tag> with SDPB artifacts
# plus aggregate scan_results.csv / scan_results.json at OUTPUT_ROOT.
export OUTPUT_ROOT=/n/homeXX/you/ising3d_runs

# Extra sbatch args, for example:
# export SBATCH_EXTRA_ARGS='--account=YOUR_ACCOUNT --time=08:00:00 --partition=shared'
